# ==============================================================================
# AMS SMS — Production Environment Configuration (.env.example)
# Copy this file to .env and configure values before starting the service.
# DO NOT commit real secrets, API keys, or passwords to git repositories!
# ==============================================================================

# Server Network & HTTP Port
PORT=4000
NODE_ENV=production

# Public Base URL — REQUIRED for the REST API integration page
# This is the externally reachable origin that integrations must call. It is
# shown to Managers and Agents as the Base URL for their /api/v1 endpoints.
# It CANNOT be derived reliably from the request: behind a reverse proxy the
# app only sees an internal host and port (often 127.0.0.1:4000), which is
# useless to an external caller.
# Set this to the real public origin — no trailing slash, no /api/v1 path.
#   PUBLIC_BASE_URL=https://sms.example.com
# If it is unset, Admins can set the same value in-panel under
# REST API -> Base URL configuration; until then the page says "not
# configured" instead of showing a guessed address.
# PUBLIC_BASE_URL=

# Mandatory Security Secret (Used for panel JWT tokens & PIN session unlocks)
# Generate a strong 64+ char random hex string (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_production_secret_key_minimum_64_chars

# Database & Storage
# Default path resolves to backend/data.sqlite relative to the project root
DB_FILE=backend/data.sqlite

# ------------------------------------------------------------------------------
# Creator Account requests (Agent/Manager registration + testing proof)
# Screenshots are written OUTSIDE the web root; only admins can fetch them.
# ------------------------------------------------------------------------------
CREATOR_UPLOAD_DIR=backend/creator-uploads
CREATOR_MAX_UPLOAD_MB=8
CREATOR_IP_LIMIT=2
CREATOR_IP_WINDOW_HOURS=24

# SQLite Engine Tuning
# Cache size in Megabytes (recommended 256 for standard VPS, 1024 for 10M+ numbers)
SQLITE_CACHE_MB=256
SQLITE_MMAP_BYTES=1073741824

# Automated Business Data Backups
# Each backup is a SMALL, self-contained database with business data only:
#   users (bcrypt hashes + identity), sms_records (content + payout inputs),
#   ranges_ref (range id + name only), payment_ledger, payment_requests_v2.
# Chat, API/SMPP credentials, providers, numbers/ranges inventory, limits,
# sharing, complaints, branding, jobs and logs are NOT included.
# Files are named ams-sms-backup-<timestamp>.sqlite. Earlier qtech-, nova- and almada-
# prefixed backup files in the same folder are still listed, restore-tested and pruned.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=3
# Retention = 5 CALENDAR months (month arithmetic, not 150 days).
# BACKUP_RETENTION_DAYS is intentionally ignored so it cannot shorten this window.
BACKUP_RETENTION_MONTHS=5
# Abandoned *.partial / snapshot temp files older than this are removed.
BACKUP_STALE_TMP_HOURS=6
# Recommended outside project folder: /home/user/ams-sms-backups
BACKUP_DIR=/home/user/ams-sms-backups

# CSV export files (background worker). Defaults to ~/ams-sms-exports when unset.
EXPORT_DIR=/home/user/ams-sms-exports

# Background Telecom Carrier Ingest Synchronization
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=12

# SMPP Protocol Service (Client & Server)
SMPP_ENABLED=true

# Carrier Configuration Unlock Password
# Used in Admin UI when unlocking carrier connection endpoints
CARRIER_LOCK_PASSWORD=ChangeThisCarrierLockPassword2026!

# Rate Limiting & Abuse Protection
API_RATE_PER_MIN=1200
INCOMING_SMS_RATE_PER_MIN=12000
HEAVY_WRITE_RATE_PER_MIN=120

# Background Worker Thread CSV Exports
EXPORT_TTL_HOURS=24
EXPORT_MAX_CONCURRENT=2

# Process role: all (default) = web + timers; api = web only; sync = timers only.
# AMS_ROLE=all

# Optional FTS5 trigram index over sms_records.message (off unless set to 1).
# AMS_FTS=0

# Optional shared secret for the internal ingest hook POST /api/webhook/sms.
# When set, callers must send it as header "x-webhook-secret", ?secret= or body field "secret".
# Leave unset to keep the historical open behaviour (block the path at the proxy instead).
# WEBHOOK_SECRET=

# Dedicated Chat app: /chat-app/login. These bootstrap separate chat-only
# Supervisor/Support identities; never change the real Admin panel password.
# Set the agreed case-sensitive values privately before first use. Rotate
# these weak shared credentials before public exposure; hashes live in SQLite.
CHAT_SUPERVISOR_INITIAL_PASSWORD=
CHAT_SUPPORT_INITIAL_PASSWORD=
# Optional background Web Push (generate with: npx web-push generate-vapid-keys)
# Keep the private key server-side and stable across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
